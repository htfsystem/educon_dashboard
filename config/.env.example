# Dashboard Server Configuration
PORT=3007

# Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=password
DB_NAME=educon_copy

# Authentication
# The login page is OFF by default on every host. Set AUTH_ENABLED=true to require
# sign-in; then ADMIN_USERNAME / ADMIN_PASSWORD seed the first administrator — once,
# on a completely empty account table and never again.
# AUTH_ENABLED=true
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me

# Accounts and the session key live in MySQL, in this schema — NOT in the production
# one, which is only ever read. Anything created through the Users page persists
# across every restart and redeploy. Leave it unset unless the schema is renamed.
# AUTH_DB_NAME=educon_test_1

# Optional: pins the session signing key. Not needed any more — one is generated and
# stored in AUTH_DB_NAME.dashboard_settings on first run, so sessions already survive
# a restart. Set it only to invalidate every session at once.
# SESSION_SECRET=

# Recovery hatch for a forgotten administrator password. With this set, the next boot
# resets ADMIN_USERNAME's password to ADMIN_PASSWORD and re-enables the account.
# Unset it again immediately afterwards.
# ADMIN_PASSWORD_RESET=true

# ---------------------------------------------------------------- deployment
# Controls the session cookie's Secure flag (server.js). If this is unset or
# misspelled on the host, session cookies ship WITHOUT Secure.
NODE_ENV=development
