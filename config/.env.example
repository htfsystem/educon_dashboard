# Authentication
# The login page is OFF by default on every host. Set AUTH_ENABLED=true to require
# sign-in; then ADMIN_USERNAME / ADMIN_PASSWORD seed the first administrator and
# SESSION_SECRET keeps sessions alive across restarts.
# AUTH_ENABLED=true
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
# SESSION_SECRET=
