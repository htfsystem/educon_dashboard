# Dashboard Server Configuration
PORT=3007

# Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=password
DB_NAME=educon_copy

# Dashboard sign-in
# Accounts live in data/dashboard.db (created on first run) and are entirely separate
# from EduCon student logins. educon_prod is never written to.
#
# ADMIN_PASSWORD seeds the very first administrator. Leave it unset and a random
# password is generated and printed once at startup — copy it before it scrolls away.
# It is only read when no accounts exist yet; after that, manage users in the UI.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Signs the session cookie. Leave blank and one is generated into data/.session-secret.
# Set it explicitly to keep sessions valid across a redeploy.
SESSION_SECRET=
vscode-webview://1jvqpf5h1fe1072kmrpljvmhh119uvkarj2qka566meosnosok7d/Dashboard/data/